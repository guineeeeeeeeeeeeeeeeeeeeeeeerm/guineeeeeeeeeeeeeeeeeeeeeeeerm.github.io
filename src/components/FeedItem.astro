---
import ItemFooter from "./ItemFooter.astro";
import { feedTitle, formatUtc, renderFeedBody, SCREEN_TEXT, type Locale, type Post, type SiteData, type Tagging, sharesFor } from "../lib/site";

interface Props {
  site: SiteData;
  post: Post;
  root: string;
  assetRoot?: string;
  locale?: Locale;
  reason?: Tagging;
}

const { site, post, root, assetRoot = root, locale = "ko", reason } = Astro.props;
const text = SCREEN_TEXT[locale];
const title = feedTitle(post);
const body = renderFeedBody(site, post, assetRoot, locale);
---

<article class="feed-item">
  <a class="item-link" href={`${root}p/${post.id}/`} aria-label={post.type === "short" ? text.viewPost : title}></a>
  {post.type === "short" ? (
    <div class="body" set:html={body}></div>
  ) : (
    <h2 class="feed-title">{title}</h2>
  )}
  {reason && locale === "ko" && <p class="tag-reason">{text.tagReason}: {reason.why} · <time datetime={reason.at} title={formatUtc(reason.at)}>{formatUtc(reason.at)}</time></p>}
  <ItemFooter post={post} shares={sharesFor(site, post.id, locale)} root={assetRoot} />
</article>
