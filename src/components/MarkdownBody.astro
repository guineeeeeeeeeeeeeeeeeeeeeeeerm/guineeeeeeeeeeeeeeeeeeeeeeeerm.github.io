---
import MarkdownBlock from "./MarkdownBlock.astro";
import type { MarkdownBlock as Block } from "../lib/site";

interface Props {
  blocks: Block[];
  imagePrefix: string;
  zoom?: boolean;
}

const { blocks, imagePrefix, zoom = false } = Astro.props;
---

{blocks.map((block) => <MarkdownBlock block={block} imagePrefix={imagePrefix} zoom={zoom} />)}
