---
import { feedTitle, postForLocale, SCREEN_TEXT, type Link, type Locale, type SiteData, type Post } from "../lib/site";

interface Props { site: SiteData; post: Post; links: Link[]; locale?: Locale; }
const { site, post, links, locale = "ko" } = Astro.props;
const text = SCREEN_TEXT[locale];
const ordered = [...links].sort((a, b) => b.createdAt.localeCompare(a.createdAt) || a.id.localeCompare(b.id));
---

{ordered.length > 0 && (
  <section class="incoming-links">
    <h2>{text.linkedFrom}</h2>
    <ul>
      {ordered.map((link) => {
        const source = postForLocale(site, link.fromId, locale)!;
        return <li><a href={`../${source.id}/`}>{feedTitle(source)}</a> — {link.currentReason}</li>;
      })}
    </ul>
  </section>
)}
