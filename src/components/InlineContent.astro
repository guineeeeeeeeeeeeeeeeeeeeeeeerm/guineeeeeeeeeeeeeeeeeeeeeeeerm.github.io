---
import InlineNode from "./InlineNode.astro";
import type { InlineNode as Node } from "../lib/site";

interface Props {
  nodes: Node[];
  imagePrefix: string;
  zoom?: boolean;
}

const { nodes, imagePrefix, zoom = false } = Astro.props;
---

{nodes.map((node) => <InlineNode node={node} imagePrefix={imagePrefix} zoom={zoom} />)}
