---
import { feedTitle, formatUtc, postForLocale, SCREEN_TEXT, type Link, type Locale, type SiteData, type Post } from "../lib/site";

interface Props { site: SiteData; post: Post; links: Link[]; locale?: Locale; }
const { site, post, links, locale = "ko" } = Astro.props;
const text = SCREEN_TEXT[locale];
---

{links.length > 0 && (
  <section class="footnotes">
    <h2>{text.notes}</h2>
    <ol>
      {links.map((link, index) => {
        const target = postForLocale(site, link.toId, locale)!;
        return <li id={`fn-${index + 1}`}><a href={`../${target.id}/`}>{feedTitle(target)}</a> — {link.currentReason} — <time datetime={link.createdAt} title={formatUtc(link.createdAt)}>{formatUtc(link.createdAt)}</time></li>;
      })}
    </ol>
  </section>
)}
