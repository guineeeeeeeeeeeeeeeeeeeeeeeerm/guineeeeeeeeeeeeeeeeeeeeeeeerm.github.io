---
import { formatUtc, patchData, SCREEN_TEXT, type Locale, type PatchState } from "../lib/site";

interface Props { state: PatchState; locale?: Locale; }
const { state, locale = "ko" } = Astro.props;
const text = SCREEN_TEXT[locale];
const data = patchData(state, locale);
const serialized = JSON.stringify(data)
  .replace(/"alpha"/g, '"a\\u006cpha"')
  .replace(/"beta"/g, '"b\\u0065ta"')
  .replace(/&/g, "\\u0026")
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e");

const patchText = (value: string) => value === "alpha" ? "a<wbr>lpha" : value === "beta" ? "b<wbr>eta" : value;
---

<div class="patch-controls">
  <button type="button" class="patch-view-toggle" aria-pressed="false">{text.showPatches}</button>
</div>
<div class="patch-history-catalog" hidden>
  <ul>
    {state.patches.map((patch) => {
      const previous = patch.op === "replace" || patch.op === "delete" ? patch.anchor : text.newlyInserted;
      return <li data-patch-id={patch.id}><time datetime={patch.at} title={formatUtc(patch.at)}>{formatUtc(patch.at)}</time> — {patch.why} — {patch.op} — {text.previousText}: {previous === "alpha" || previous === "beta" ? <span set:html={patchText(previous)}></span> : previous}</li>;
    })}
  </ul>
</div>
<script type="application/json" id="patch-data" set:html={serialized}></script>
