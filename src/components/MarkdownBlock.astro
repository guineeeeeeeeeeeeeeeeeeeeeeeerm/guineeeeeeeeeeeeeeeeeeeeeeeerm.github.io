---
import InlineContent from "./InlineContent.astro";
import MarkdownLine from "./MarkdownLine.astro";
import type { MarkdownBlock as Block } from "../lib/site";

interface Props {
  block: Block;
  imagePrefix: string;
  zoom?: boolean;
}

const { block, imagePrefix, zoom = false } = Astro.props;
---

{block.kind === "heading" && block.level === 1 && <h1><InlineContent nodes={block.content} imagePrefix={imagePrefix} zoom={zoom} /></h1>}{block.kind === "heading" && block.level === 2 && <h2><InlineContent nodes={block.content} imagePrefix={imagePrefix} zoom={zoom} /></h2>}{block.kind === "heading" && block.level === 3 && <h3><InlineContent nodes={block.content} imagePrefix={imagePrefix} zoom={zoom} /></h3>}{block.kind === "list" && <ul>{block.items.map((item) => <li><InlineContent nodes={item} imagePrefix={imagePrefix} zoom={zoom} /></li>)}</ul>}{block.kind === "quote" && <blockquote>{block.lines.map((line, index) => <MarkdownLine nodes={line} imagePrefix={imagePrefix} zoom={zoom} breakAfter={index < block.lines.length - 1} />)}</blockquote>}{block.kind === "paragraph" && <p>{block.lines.map((line, index) => <MarkdownLine nodes={line} imagePrefix={imagePrefix} zoom={zoom} breakAfter={index < block.lines.length - 1} />)}</p>}
