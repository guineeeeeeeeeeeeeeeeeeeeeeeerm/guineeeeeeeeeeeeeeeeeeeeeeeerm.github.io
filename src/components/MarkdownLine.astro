---
import InlineContent from "./InlineContent.astro";
import type { InlineNode } from "../lib/site";

interface Props {
  nodes: InlineNode[];
  imagePrefix: string;
  zoom?: boolean;
  breakAfter?: boolean;
}

const { nodes, imagePrefix, zoom = false, breakAfter = false } = Astro.props;
---

<InlineContent nodes={nodes} imagePrefix={imagePrefix} zoom={zoom} />{breakAfter && <br />}
