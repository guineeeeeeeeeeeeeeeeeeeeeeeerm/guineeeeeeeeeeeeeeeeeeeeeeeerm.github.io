---
import ShareBadges from "./ShareBadges.astro";
import { formatUtc, type Post, type Share } from "../lib/site";

interface Props {
  post: Post;
  shares: Share[];
  root: string;
}

const { post, shares, root } = Astro.props;
---

<footer class="item-footer">
  <time datetime={post.written} title={formatUtc(post.written)}>{formatUtc(post.written)}</time>
  <ShareBadges shares={shares} root={root} />
</footer>
