---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarkdownBody from "../../components/MarkdownBody.astro";
import { loadSite } from "../../lib/site";

const site = loadSite();
---

<BaseLayout title="소개" rootLink="../" current="about" includeZoom={true}>
  <main>
    <article class="post">
      <div class="body"><MarkdownBody blocks={site.about} imagePrefix="../images/" zoom={true} /></div>
    </article>
  </main>
</BaseLayout>
