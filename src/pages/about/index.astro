---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSite, renderAboutBody } from "../../lib/site";

const site = loadSite();
const body = renderAboutBody(site, "../");
---

<BaseLayout title="소개" rootLink="../" current="about" includeZoom={true}>
  <main>
    <article class="post">
      <div class="body" set:html={body}></div>
    </article>
  </main>
</BaseLayout>
