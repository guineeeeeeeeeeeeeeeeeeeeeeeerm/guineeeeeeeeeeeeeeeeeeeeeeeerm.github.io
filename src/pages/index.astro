---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeedItem from "../components/FeedItem.astro";
import TagCloud from "../components/TagCloud.astro";
import { feedPosts, loadSite } from "../lib/site";

const site = loadSite();
const posts = feedPosts(site);
---

<BaseLayout title="피드" rootLink="" current="feed" switchHref="en/" switchLabel="English" switchLang="en" alternateHref="en/" alternateLang="en">
  <div class="feed-layout">
    <main>
      <h1>피드</h1>
      <section class="feed">
        {posts.map((post) => <FeedItem site={site} post={post} root="" assetRoot="" />)}
      </section>
    </main>
    <TagCloud site={site} locale="ko" />
  </div>
</BaseLayout>
