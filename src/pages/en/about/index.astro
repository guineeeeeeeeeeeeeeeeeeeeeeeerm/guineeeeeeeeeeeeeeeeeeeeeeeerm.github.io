---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadSite, metadataForPage, renderAboutBody } from "../../../lib/site";

const site = loadSite();
const body = renderAboutBody(site, "../../", "en");
const metadata = metadataForPage({ locale: "en", kind: "about", hasAlternate: true });
---

<BaseLayout metadata={metadata} rootLink="../" assetRoot="../../" locale="en" current="about" switchHref="../../about/" switchLabel="한국어" switchLang="ko" alternateHref="../../about/" alternateLang="ko" includeZoom={true}>
  <main>
    <article class="post">
      <div class="body" set:html={body}></div>
    </article>
  </main>
</BaseLayout>
