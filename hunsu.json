{
  "hosts": [
    "claude-code"
  ],
  "engines": {
    "claude-code": ">=2.1",
    "python": ">=3.9"
  },
  "plugins": {
    "hunsu": {
      "version": "1.2.3",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hunsu",
      "marketplace": "hunsu"
    },
    "chongdae": {
      "version": "1.3.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/chongdae",
      "marketplace": "chongdae"
    },
    "mangsang": {
      "version": "1.3.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/mangsang",
      "marketplace": "mangsang"
    },
    "dwitbuk": {
      "version": "1.1.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/dwitbuk",
      "marketplace": "dwitbuk"
    },
    "hacheong": {
      "version": "1.1.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hacheong",
      "marketplace": "hacheong"
    }
  },
  "roles": {
    "implementer": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "dakdol",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "quibble": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "sibi",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "nitpick": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "teujip",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "newbie": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "chojja",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "verifier": [
      "python3",
      "{plugin:dwitbuk}/eyes_worker.py",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "coherence": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--target",
      "."
    ]
  },
  "reporters": {
    "chongdae": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "report",
      "--since",
      "{since}"
    ],
    "mangsang-impact": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--findings"
    ],
    "mangsang-check": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "check",
      "--findings"
    ],
    "mangsang-cq": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "cq",
      "--findings"
    ],
    "hunsu": [
      "python3",
      "{plugin:hunsu}/hunsu.py",
      "check",
      "--findings"
    ]
  },
  "resolutions": {
    "reviewing a change or run": {
      "order": [
        "plugin:chongdae",
        "dwitbuk:review"
      ],
      "reviewed": {
        "by": "Claude Opus 5.5, in the owner's stead (asked to write the resolutions), 2026-09-23",
        "why": "Read both quotes. The review record is written inside a run; start one before committing reviews/<id>.json."
      }
    },
    "building a slice": {
      "accept": "A build member is hired by chongdae inside a run, so its session sees a run in progress and the guard admits the task's writes.",
      "reviewed": {
        "by": "Claude Opus 5.5, in the owner's stead (asked to write the resolutions), 2026-09-23",
        "why": "Read both quotes; the worker's edits happen within the run that hired it."
      }
    },
    "writing tests for a slice": {
      "accept": "nitpick is a chongdae task of its own (`add tests --role nitpick`), so its test files are written inside a run.",
      "reviewed": {
        "by": "Claude Opus 5.5, in the owner's stead (asked to write the resolutions), 2026-09-23",
        "why": "Read both quotes. Not taken: the proposed deny, which would remove the only member that writes a contract's tests first."
      }
    },
    "locking the project environment": {
      "accept": "Sequential: hunsu's engine writes hunsu.json and hunsu.lock.json itself; hand edits to hunsu.json and the commit happen inside a chongdae session run.",
      "reviewed": {
        "by": "Claude Opus 5.5, in the owner's stead (asked to write the resolutions), 2026-09-23",
        "why": "Read both quotes; the guard line is the state when nothing runs, not a rule against composing."
      }
    },
    "maintaining project concepts and relations": {
      "order": [
        "plugin:chongdae",
        "mangsang:operate"
      ],
      "reviewed": {
        "by": "Claude Opus 5.5, in the owner's stead (asked to write the resolutions), 2026-09-23",
        "why": "Read both quotes; checks are read-only and need no run, declarations and relations are written inside one."
      }
    }
  },
  "local-hooks-ok": [],
  "settings": {
    "dwitbuk": {
      "stop-eyes": false
    }
  }
}
