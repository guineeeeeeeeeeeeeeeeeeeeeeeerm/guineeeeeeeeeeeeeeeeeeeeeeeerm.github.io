{
  "hosts": [
    "claude-code"
  ],
  "engines": {
    "claude-code": ">=2.1",
    "python": ">=3.9"
  },
  "plugins": {
    "hunsu": {
      "version": "1.4.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hunsu",
      "marketplace": "hunsu"
    },
    "chongdae": {
      "version": "1.7.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/chongdae",
      "marketplace": "chongdae"
    },
    "mangsang": {
      "version": "1.5.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/mangsang",
      "marketplace": "mangsang"
    },
    "dwitbuk": {
      "version": "1.4.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/dwitbuk",
      "marketplace": "dwitbuk"
    },
    "hacheong": {
      "version": "1.3.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hacheong",
      "marketplace": "hacheong"
    }
  },
  "roles": {
    "implementer": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "dakdol",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "quibble": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "sibi",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "nitpick": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "teujip",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "newbie": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "chojja",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "verifier": [
      "python3",
      "{plugin:dwitbuk}/eyes_worker.py",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex",
      "--model",
      "gpt-5.6-luna",
      "--effort",
      "xhigh"
    ],
    "coherence": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--target",
      "."
    ],
    "reviewer": [
      "python3",
      "{plugin:dwitbuk}/dwitbuk.py",
      "review",
      "--target",
      "."
    ]
  },
  "reporters": {
    "chongdae": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "report",
      "--since",
      "{since}"
    ],
    "mangsang-impact": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--findings"
    ],
    "mangsang-check": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "check",
      "--findings"
    ],
    "mangsang-cq": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "cq",
      "--findings"
    ],
    "hunsu": [
      "python3",
      "{plugin:hunsu}/hunsu.py",
      "check",
      "--findings"
    ]
  },
  "resolutions": {
    "reviewing a change or run": {
      "order": [
        "plugin:chongdae",
        "dwitbuk:review"
      ],
      "reviewed": {
        "delegated": "judge codex gpt-5.6-luna: The existing order remains compatible: chongdae governs the active run and its writes, then dwitbuk:review performs the review."
      }
    },
    "building a slice": {
      "accept": "A build member is hired by chongdae inside a run, so its session sees a run in progress and the guard admits the task's writes.",
      "reviewed": {
        "delegated": "judge codex gpt-5.6-luna: The existing resolution directly explains why the build worker may make its required code changes while the run guard permits those writes."
      }
    },
    "writing tests for a slice": {
      "accept": "nitpick is a chongdae task of its own (`add tests --role nitpick`), so its test files are written inside a run.",
      "reviewed": {
        "delegated": "judge codex gpt-5.6-luna: The existing resolution fits because nitpick remains the member responsible for writing contract tests, and the current chongdae mode explicitly permits writes through the active run."
      }
    },
    "locking the project environment": {
      "accept": "Sequential: hunsu's engine writes hunsu.json and hunsu.lock.json itself; hand edits to hunsu.json and the commit happen inside a chongdae session run.",
      "reviewed": {
        "by": "Claude Opus 5.5, in the owner's stead (asked to write the resolutions), 2026-09-23",
        "why": "Read both quotes; the guard line is the state when nothing runs, not a rule against composing."
      }
    },
    "maintaining project concepts and relations": {
      "order": [
        "plugin:chongdae",
        "mangsang:operate"
      ],
      "reviewed": {
        "delegated": "judge codex gpt-5.6-luna: The run is already in progress, so chongdae can govern the writes before mangsang:operate maintains concepts and relations."
      }
    }
  },
  "local-hooks-ok": [],
  "settings": {
    "dwitbuk": {
      "stop-eyes": false
    },
    "chongdae": {
      "outside-runs": [
        "content/",
        "docs/"
      ]
    }
  },
  "dev-settings": {
    "chongdae": {
      "commit-records": false
    }
  }
}
